<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 380" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0ea5e9" />
      <stop offset="100%" stop-color="#38bdf8" />
    </linearGradient>
    <linearGradient id="cardBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.9" />
      <stop offset="100%" stop-color="#f8fafc" stop-opacity="0.85" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#000000" flood-opacity="0.12" />
    </filter>
  </defs>

  <!-- Background Base -->
  <rect width="600" height="380" rx="18" fill="url(#bg)" />

  <!-- Grid Pattern Overlay -->
  <g opacity="0.15" stroke="#ffffff" stroke-width="1">
    <line x1="0" y1="60" x2="600" y2="60" />
    <line x1="0" y1="120" x2="600" y2="120" />
    <line x1="0" y1="180" x2="600" y2="180" />
    <line x1="0" y1="240" x2="600" y2="240" />
    <line x1="0" y1="300" x2="600" y2="300" />
    <line x1="100" y1="0" x2="100" y2="380" />
    <line x1="200" y1="0" x2="200" y2="380" />
    <line x1="300" y1="0" x2="300" y2="380" />
    <line x1="400" y1="0" x2="400" y2="380" />
    <line x1="500" y1="0" x2="500" y2="380" />
  </g>

  <!-- Inner Glass Container -->
  <rect x="40" y="36" width="520" height="308" rx="14" fill="url(#cardBg)" filter="url(#shadow)" stroke="#ffffff" stroke-opacity="0.8" stroke-width="2" />

  <!-- App Window Bar -->
  <rect x="40" y="36" width="520" height="42" rx="14" fill="#0f172a" fill-opacity="0.06" />
  <circle cx="68" cy="57" r="5" fill="#ef4444" />
  <circle cx="86" cy="57" r="5" fill="#f59e0b" />
  <circle cx="104" cy="57" r="5" fill="#10b981" />
  <rect x="130" y="49" width="160" height="16" rx="8" fill="#ffffff" fill-opacity="0.7" />

  <!-- Category Tag Badge -->
  <g transform="translate(430, 48)">
    <rect width="110" height="20" rx="10" fill="#06b6d4" fill-opacity="0.15" />
    <text x="55" y="14" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="10" font-weight="700" fill="#0891b2" text-anchor="middle">PYTHON / GROQ</text>
  </g>

  <!-- Icon Graphic -->
  <g transform="translate(70, 110)">
    <circle cx="45" cy="45" r="42" fill="#06b6d4" fill-opacity="0.15" />
<path d="M25 35 C25 26 34 20 45 20 C56 20 65 26 65 35 C65 44 56 50 45 50 C40 50 35 48 32 46 L24 50 L26 43 C25.3 40.5 25 37.8 25 35 Z" fill="#06b6d4" />
<circle cx="37" cy="35" r="3" fill="#ffffff" /><circle cx="45" cy="35" r="3" fill="#ffffff" /><circle cx="53" cy="35" r="3" fill="#ffffff" />
  </g>

  <!-- Content Details -->
  <g transform="translate(190, 125)">
    <text x="0" y="32" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="28" font-weight="800" fill="#0f172a">KashishBot</text>
    <text x="0" y="65" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" font-weight="500" fill="#475569">Ultra-fast Groq LLM Assistant</text>

    <!-- Simulated UI Pill elements -->
    <g transform="translate(0, 95)">
      <rect width="110" height="28" rx="14" fill="#06b6d4" />
      <text x="55" y="18" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="12" font-weight="600" fill="#ffffff" text-anchor="middle">Interactive</text>

      <rect x="125" y="0" width="100" height="28" rx="14" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="1" />
      <text x="175" y="18" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="12" font-weight="600" fill="#334155" text-anchor="middle">Live Status</text>
    </g>
  </g>

  <!-- Bottom Accent Bar -->
  <rect x="40" y="340" width="520" height="4" fill="url(#bg)" />
</svg>